# ==============================================================================
# MAKRAY — Environment Variable Template
# ==============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI / Claude
# ------------------------------------------------------------------------------

# Your Anthropic API key (required)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Obsidian Vault
# ------------------------------------------------------------------------------

# Absolute path to your Obsidian vault directory (required)
# Example (macOS):  /Users/yourname/Documents/MyVault
# Example (Linux):  /home/yourname/vault
# Example (Windows): C:\Users\yourname\Documents\MyVault
MAKRAY_VAULT=/path/to/your/obsidian/vault

# ------------------------------------------------------------------------------
# Database (Phase 2+)
# ------------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/makray

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------

# Application environment: development | production | test
NODE_ENV=development

# Web server port (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Frontend (Phase 3+)
# ------------------------------------------------------------------------------

# Base URL for the backend API, consumed by the Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
